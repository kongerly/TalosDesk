<Project>
  <PropertyGroup>
    <Version>0.3.0-preview.1</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0-preview.1</InformationalVersion>
    <ReleaseChannel>Preview</ReleaseChannel>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'TalosDesk.App'">
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    P2-16 工程规范：警告即错误。
    具体规则集写在仓库根 .editorconfig，属性只在 Directory.Build.props 声明一次。
    .editorconfig 在构建的展开阶段最后生效，因此可以逐条覆盖这里的严重级别。
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
