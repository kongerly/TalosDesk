<UserControl x:Class="TalosDesk.App.Editing.PowerShellCommandEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F8FCFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <avalonEdit:TextEditor x:Name="Editor"
                                   AutomationProperties.AutomationId="CommandBox"
                                   AutomationProperties.Name="命令"
                                   Background="Transparent" Foreground="{StaticResource InkBrush}"
                                   FontFamily="{StaticResource CodeFont}" FontSize="13"
                                   Padding="0,8,8,8"
                                   WordWrap="False" ShowLineNumbers="False"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   PreviewKeyDown="Editor_PreviewKeyDown"
                                   TextChanged="Editor_TextChanged" />
        </Border>
        <Grid Grid.Row="1" Margin="2,6,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
            <TextBlock Grid.Column="1" Text="Tab 补全 · Ctrl+Enter 保存" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
        </Grid>

        <Popup x:Name="CompletionPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=Editor}"
               Placement="Relative" StaysOpen="False" AllowsTransparency="True" Focusable="False">
            <Border Background="#FFFFFF" BorderBrush="#8EB8C8" BorderThickness="1" CornerRadius="7"
                    Padding="4" MinWidth="220" MaxWidth="430">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="13" ShadowDepth="3" Opacity="0.19" />
                </Border.Effect>
                <ListBox x:Name="CompletionList" MaxHeight="220" BorderThickness="0" Background="Transparent"
                         IsTabStop="False" MouseDoubleClick="CompletionList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,2,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
