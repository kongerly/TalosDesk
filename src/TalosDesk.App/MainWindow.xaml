<Window x:Class="TalosDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TalosDesk.App"
        Title="TalosDesk · 本地项目指挥台" Height="860" Width="1400" MinHeight="650" MinWidth="1050"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BodyFont}" WindowStartupLocation="CenterScreen" Icon="Assets/TalosDeskMark.ico"
        Loaded="MainWindow_Loaded" Activated="MainWindow_Activated" Closing="MainWindow_Closing" Deactivated="MainWindow_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#327F9B" />
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E6F5FB" Offset="0.72" />
            <GradientStop Color="#E6EDF9" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CommandCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F1F9FC" Offset="1" />
        </LinearGradientBrush>
        <local:CommandKindToChineseConverter x:Key="CommandKindConverter" />
        <local:OutputStreamToChineseConverter x:Key="OutputStreamConverter" />
        <local:CommandGroupModeToChineseConverter x:Key="CommandGroupModeConverter" />
        <DrawingBrush x:Key="BlueprintGridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Viewbox="0,0,32,32" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#C6DAE7" Thickness="0.6" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource EditorButton}" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource EditorPrimaryButton}" />
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{StaticResource SidebarRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#B6D1DC" />
        </Style>
        <Style x:Key="PageNavigationButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="BaseListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem" BasedOn="{StaticResource BaseListItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="10,3">
                            <Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="11">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="SelectionRail" Width="3" Background="{StaticResource GoldBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10,0,10" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EEF9FC" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F8FDFF" /><Setter TargetName="RowSurface" Property="BorderBrush" Value="#A7CEDC" /><Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" /><Setter TargetName="RowSurface" Property="BorderThickness" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommandItem" TargetType="ListBoxItem" BasedOn="{StaticResource BaseListItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowSurface" Background="{StaticResource CommandCardBrush}" BorderBrush="#D5E7EE" BorderThickness="1" CornerRadius="11" Margin="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EAF7FC" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#E8F5FA" /><Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" /><Setter TargetName="RowSurface" Property="BorderThickness" Value="1.5" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BatchCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckSurface" Width="23" Height="23" Background="#FFFFFF" BorderBrush="#9FC7D7" BorderThickness="1.5" CornerRadius="6">
                            <Path x:Name="CheckMark" Data="M 5,11 L 9,15 L 18,6" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource JadeBrush}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource JadeBrush}" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#B8D5E2" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,11,18,12">
                    <Grid Height="56">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center" Source="Assets/TalosDeskMark.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                            <TextBlock Text="TALOSDESK" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BrandFont}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="机巧指挥台" Foreground="{StaticResource JadeBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="7" Margin="0,5,0,0">
                        <Border Height="1" Background="#A9CEDB" VerticalAlignment="Center" />
                        <Path Data="M 0,3.5 L 3.5,0 L 7,3.5 L 3.5,7 Z" Fill="{StaticResource GoldBrush}" Width="7" Height="7" HorizontalAlignment="Left" />
                        <Border Width="76" Height="2" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,0,18,8">
                    <TextBlock Text="工作区域" Foreground="#935B42" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" Margin="6,0,0,5" />
                    <Button x:Name="OverviewPageButton" Content="项目概览" Style="{StaticResource PageNavigationButton}" Click="OverviewPage_Click" />
                    <Button x:Name="CommandsPageButton" Content="命令管理" Style="{StaticResource PageNavigationButton}" Click="CommandsPage_Click" />
                    <Button x:Name="GroupsPageButton" Content="分组管理" Style="{StaticResource PageNavigationButton}" Click="GroupsPage_Click" />
                    <Button x:Name="OutputPageButton" Content="运行输出" Style="{StaticResource PageNavigationButton}" Click="OutputPage_Click" />
                    <Button x:Name="AboutPageButton" Content="关于与更新" Style="{StaticResource PageNavigationButton}" Click="AboutPage_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,10">
                    <Button x:Name="AddProjectButton" Content="＋   添加项目" Style="{StaticResource SidebarButton}" HorizontalAlignment="Stretch" Click="AddProject_Click" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ImportButton" Content="导入" Style="{StaticResource SidebarButton}" Click="ImportWorkspace_Click" />
                        <Button x:Name="ExportButton" Grid.Column="2" Content="导出" Style="{StaticResource SidebarButton}" Click="ExportWorkspace_Click" />
                    </Grid>
                    <TextBlock x:Name="SaveStatusText" Text="本机配置" Foreground="{StaticResource JadeBrush}" FontSize="11" FontWeight="SemiBold" Margin="3,8,3,0" />
                    <TextBlock x:Name="WorkspaceProfileText" Text="正式工作区" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="3,4,3,0" />
                    <TextBlock x:Name="WorkspacePathText" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource CodeFont}" FontSize="9" Margin="3,3,3,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PROJECT ARCHIVE   /   项目" Foreground="#935B42" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" Margin="24,0,18,5" />
                    <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkBrush}" ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="ProjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="13,8,13,8" ToolTip="{Binding Directory}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="M 7,0 L 14,7 L 7,14 L 0,7 Z" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5" Fill="#FFF7ED" Width="12" Height="12" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyProjectsHint" Text="还没有项目。添加本地文件夹以保存项目命令。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="24,20,24,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="22,19,25,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="UpdateBanner" Grid.Row="0" Background="#E8F5FA" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerTitle" Text="发现新版本" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="UpdateBannerText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Content="查看发布页面" Style="{StaticResource PrimaryButton}" Click="OpenReminderRelease_Click" />
                        <Button Content="稍后" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="RemindLater_Click" />
                        <Button Content="跳过此版本" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="SkipVersion_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="OverviewPage" Grid.Row="1">
                <Grid x:Name="OverviewDetails">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource HeroBrush}" BorderBrush="#B6D8E5" BorderThickness="1" CornerRadius="15" ClipToBounds="True">
                        <Grid MinHeight="165">
                            <Image Source="Assets/TalosDeskMark.png" Width="180" Height="180" Opacity="0.11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,105,0" IsHitTestVisible="False" />
                            <Border Width="5" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left" Margin="0,24" CornerRadius="3" />
                            <Grid Margin="28,23">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TALOS  /  项目概览" Foreground="{StaticResource JadeBrush}" FontFamily="{StaticResource CodeFont}" FontSize="11" FontWeight="Bold" Margin="1,0,0,7" />
                                    <TextBlock x:Name="ProjectNameText" Text="选择一个项目" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" />
                                    <TextBlock x:Name="ProjectPathText" Text="添加本地文件夹以开始使用" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="EditProjectButton" Grid.Column="1" Content="编辑项目" Style="{StaticResource ActionButton}" VerticalAlignment="Center" Margin="18,0,0,0" Click="EditProject_Click" IsEnabled="False" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="已保存的命令" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="CommandCountText" Text="0" FontFamily="{StaticResource CodeFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource JadeBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="正在运行" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="OverviewRunningCountText" Text="0" FontFamily="{StaticResource CodeFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource JadeBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="本次会话有结果的命令" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="OverviewFinishedCountText" Text="0" FontFamily="{StaticResource CodeFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource JadeBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource HeroBrush}" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Margin="0,18,0,0" Padding="23,20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="下一步" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="管理此项目的命令，或查看本次会话的运行输出。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,17" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OverviewCommandsButton" Content="查看命令" Style="{StaticResource PrimaryButton}" Click="CommandsPage_Click" />
                                <Button x:Name="OverviewOutputButton" Content="查看运行输出" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="OutputPage_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="OverviewEmptyHint" Text="还没有项目。请使用左侧的“添加项目”开始。" Foreground="{StaticResource MutedBrush}" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="CommandsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="命令管理" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="CommandsProjectText" Text="选择项目以查看命令" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="BatchRunButton" Grid.Column="1" Content="同时运行 (0)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RunCheckedCommands_Click" IsEnabled="False" ToolTip="同时启动当前项目中勾选且尚未运行的命令" />
                    <Button x:Name="AddCommandButton" Grid.Column="2" Content="＋  添加命令" Style="{StaticResource ActionButton}" Click="AddCommand_Click" IsEnabled="False" />
                </Grid>
                <Border Grid.Row="1" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Background="#F0F8FC" MinHeight="44">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="BatchSelectionHint" Text="勾选同时运行 · 双击编辑 · 拖动排序" Margin="17,0,8,0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="MoveCommandUpButton" Grid.Column="1" Content="↑ 上移" Style="{StaticResource SidebarButton}" Padding="10,5" Margin="0,5,6,5" Click="MoveCommandUp_Click" IsEnabled="False" />
                            <Button x:Name="MoveCommandDownButton" Grid.Column="2" Content="↓ 下移" Style="{StaticResource SidebarButton}" Padding="10,5" Margin="0,5,6,5" Click="MoveCommandDown_Click" IsEnabled="False" />
                            <Button x:Name="DeleteCommandButton" Grid.Column="3" Content="删除" Style="{StaticResource SidebarButton}" Foreground="#9B4E42" Padding="11,5" Margin="0,5,12,5" Click="DeleteCommand_Click" IsEnabled="False" ToolTip="先选中一条已停止的命令" />
                        </Grid>
                        <ListBox x:Name="CommandList" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CommandItem}"
                                 SelectionChanged="CommandList_SelectionChanged" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="CommandList_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="CommandList_PreviewMouseLeftButtonUp"
                                 PreviewMouseMove="CommandList_PreviewMouseMove"
                                 MouseDoubleClick="CommandList_MouseDoubleClick"
                                 DragOver="CommandList_DragOver" DragLeave="CommandList_DragLeave" Drop="CommandList_Drop"
                                 QueryContinueDrag="CommandList_QueryContinueDrag"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="76">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="BatchCheckBox" Grid.Column="0" Style="{StaticResource BatchCheckBox}" AutomationProperties.Name="{Binding Name, StringFormat=勾选 {0}}" ToolTip="勾选后可与其他命令同时运行" Loaded="BatchCheckBox_Loaded" Checked="BatchCheckBox_Changed" Unchecked="BatchCheckBox_Changed" />
                                        <Border Grid.Column="1" Background="{StaticResource GoldBrush}" CornerRadius="3" Margin="0,11" />
                                        <StackPanel Grid.Column="2" Margin="15,11,12,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <Border Background="#DFEFF5" CornerRadius="8" Padding="7,2" Margin="10,1,0,0"><TextBlock Text="{Binding Kind, Converter={StaticResource CommandKindConverter}}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource JadeBrush}" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" FontFamily="{StaticResource CodeFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Purpose}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,16,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyCommandsHint" Grid.Row="1" Text="为此项目添加命令，运行输出可在“运行输出”页查看。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" TextAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource HeroBrush}" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="12" Margin="0,11,0,0" Padding="14,9">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedCommandName" Text="请选择命令" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RunStateText" Grid.Column="1" Text="空闲" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                            <Button x:Name="RunButton" Content="运行" Style="{StaticResource PrimaryButton}" Click="RunCommand_Click" IsEnabled="False" />
                            <Button x:Name="StopButton" Content="停止" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="StopCommand_Click" IsEnabled="False" />
                            <Button x:Name="RestartButton" Content="重启" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="RestartCommand_Click" IsEnabled="False" />
                            <Button x:Name="EditButton" Content="编辑" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="EditCommand_Click" IsEnabled="False" />
                            <Button x:Name="CopyButton" Content="复制命令" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="CopyCommand_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GroupsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="分组管理" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="GroupsProjectText" Text="选择项目以查看分组" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="AddGroupButton" Grid.Column="1" Content="＋  添加分组" Style="{StaticResource PrimaryButton}" Click="AddGroup_Click" IsEnabled="False" />
                </Grid>
                <Border Grid.Row="1" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Background="#F0F8FC" MinHeight="48">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="17,0,8,0" VerticalAlignment="Center">
                                <Path Data="M 0,5 L 5,0 L 10,5 L 5,10 Z" Fill="#FFF7ED" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.4" Width="10" Height="10" />
                                <TextBlock Text="执行轨道按保存顺序启动；同一命令可以出现在多个分组中" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="9,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="GroupCountText" Grid.Column="1" Text="0 个分组" Foreground="{StaticResource JadeBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,17,0" />
                        </Grid>
                        <ListBox x:Name="GroupList" Grid.Row="1" ItemsSource="{Binding GroupItems}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CommandItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="112" Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource GoldBrush}" CornerRadius="3" Margin="0,12" />
                                        <StackPanel Grid.Column="1" Margin="17,13,18,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" />
                                                <Border Background="#DFEFF5" CornerRadius="8" Padding="7,2" Margin="10,1,0,0">
                                                    <TextBlock Text="{Binding Group.ExecutionMode, Converter={StaticResource CommandGroupModeConverter}}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource JadeBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding MemberCountText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="9,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MemberPath}" FontFamily="{StaticResource CodeFont}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource JadeBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <Button Content="运行分组" Style="{StaticResource PrimaryButton}" Padding="14,7" IsEnabled="{Binding CanRun}" Click="RunGroup_Click" />
                                            <Button Content="编辑" Style="{StaticResource ActionButton}" Padding="12,7" Margin="7,0,0,0" IsEnabled="{Binding CanEdit}" Click="EditGroup_Click" />
                                            <Button Content="删除" Style="{StaticResource ActionButton}" Padding="12,7" Margin="7,0,0,0" Foreground="#9B4E42" IsEnabled="{Binding CanEdit}" Click="DeleteGroup_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyGroupsHint" Grid.Row="1" Text="还没有分组。把经常一起使用的命令编成一条执行轨道。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350" TextAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="OutputPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="运行输出" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="OutputProjectText" Text="选择项目以查看输出" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="235" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="当前项目的命令" Background="#F0F8FC" Padding="14,13" FontSize="12" FontWeight="Bold" />
                            <ListBox x:Name="OutputCommandList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="OutputCommandList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="13,9">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyOutputCommandsHint" Grid.Row="1" Text="此项目尚无命令。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2">
                        <Border Background="{StaticResource LogBrush}" BorderBrush="#B9D6E6" BorderThickness="1" CornerRadius="14" />
                        <Border Background="{StaticResource BlueprintGridBrush}" CornerRadius="14" Opacity="0.25" IsHitTestVisible="False" />
                        <Grid Margin="18,14,18,15">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OUTPUT  /  执行记录" Foreground="#935B42" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="LogCommandName" Text="选择命令以查看输出" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="RunStartedText" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="OutputRunStateText" Grid.Column="1" Text="空闲" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="OutputRunButton" Content="运行" Style="{StaticResource PrimaryButton}" Click="RunCommand_Click" IsEnabled="False" />
                                <Button x:Name="OutputStopButton" Content="停止" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="StopCommand_Click" IsEnabled="False" />
                                <Button x:Name="OutputRestartButton" Content="重启" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Click="RestartCommand_Click" IsEnabled="False" />
                                <Button x:Name="CopySelectedOutputButton" Content="复制所选" Style="{StaticResource SidebarButton}" Margin="7,0,0,0" Click="CopySelectedOutput_Click" IsEnabled="False" ToolTip="先拖选任意文本，再复制；Ctrl+A 可选择全部输出" />
                                <Button x:Name="ClearOutputButton" Content="清空显示" Style="{StaticResource SidebarButton}" Margin="7,0,0,0" Click="ClearOutput_Click" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="运行批次" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="RunHistoryComboBox" Width="225" DisplayMemberPath="Label" SelectionChanged="RunHistoryComboBox_SelectionChanged" />
                                <TextBlock Text="输出通道" VerticalAlignment="Center" Margin="10,0,6,0" />
                                <ComboBox x:Name="HistoryStreamComboBox" Width="100" SelectionChanged="HistoryStreamComboBox_SelectionChanged">
                                    <ComboBoxItem Content="标准输出" /><ComboBoxItem Content="诊断输出" />
                                </ComboBox>
                                <TextBlock x:Name="LogStatusText" Foreground="#935B42" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="日志上限" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox x:Name="LogLimitMbTextBox" Style="{StaticResource EditorTextBox}" Width="65" Height="30" Padding="5,2" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                                <TextBlock Text="MB · 保留" VerticalAlignment="Center" Margin="5,0" />
                                <TextBox x:Name="LogRetentionDaysTextBox" Style="{StaticResource EditorTextBox}" Width="48" Height="30" Padding="5,2" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                                <TextBlock Text="天" VerticalAlignment="Center" Margin="5,0,8,0" />
                                <Button x:Name="SaveLogSettingsButton" Content="保存设置" Style="{StaticResource SidebarButton}" Click="SaveLogSettings_Click" />
                                <Button x:Name="OpenLogFolderButton" Content="打开目录" Style="{StaticResource SidebarButton}" Margin="7,0,0,0" Click="OpenLogFolder_Click" />
                                <Button x:Name="ClearHistoryButton" Content="清理历史日志" Style="{StaticResource SidebarButton}" Margin="7,0,0,0" Click="ClearHistory_Click" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,8,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button x:Name="ChangeLogFolderButton" Content="选择日志位置" Style="{StaticResource SidebarButton}" Click="ChangeLogFolder_Click" />
                                    <Button x:Name="ResetLogFolderButton" Content="恢复默认位置" Style="{StaticResource SidebarButton}" Margin="7,0,0,0" Click="ResetLogFolder_Click" />
                                </StackPanel>
                                <TextBlock x:Name="LogPathText" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="选择新位置会创建本工作区专属目录、迁移历史并清理旧目录。日志以明文保存，可能包含令牌；可在此清理已结束批次，或关闭应用后手工删除实际目录。历史输出在此显示最近 10,000 行。" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="OutputTextBox" Grid.Row="5" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource LogTextBrush}" CaretBrush="{StaticResource JadeBrush}"
                                     FontFamily="{StaticResource CodeFont}" FontSize="11" Padding="0,2,0,0"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     SelectionBrush="#5DB7D0" SelectionOpacity="0.38"
                                     SelectionChanged="OutputTextBox_SelectionChanged"
                                     ScrollViewer.ScrollChanged="OutputTextBox_ScrollChanged"
                                     ToolTip="可拖选任意字符或跨行范围；Ctrl+C 复制，Ctrl+A 全选。stderr 显示为诊断输出，不等于命令失败。">
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制所选" Command="{x:Static ApplicationCommands.Copy}"
                                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="全选" Command="{x:Static ApplicationCommands.SelectAll}"
                                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                            <TextBlock x:Name="EmptyOutputHint" Grid.Row="5" Text="选择左侧命令以查看输出。" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                        <TextBlock Text="关于与更新" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="查看当前构建并控制此工作区的更新检查。更新只提示可用版本，不会下载或替换程序。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,12" TextWrapping="Wrap" />

                        <Border Background="{StaticResource HeroBrush}" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="当前版本" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="CurrentVersionText" Text="读取中" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="构建渠道" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="BuildChannelText" Text="读取中" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                    <TextBlock Text="实际更新渠道" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="EffectiveChannelText" Text="读取中" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" Padding="18,15">
                                <StackPanel>
                                    <TextBlock Text="检查设置" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" />
                                    <CheckBox x:Name="AutomaticUpdateCheckBox" Content="启动时检查更新（下次启动生效）" Margin="0,13,0,0" Click="AutomaticUpdateCheckBox_Click" IsEnabled="False" />
                                    <TextBlock Text="自动检查默认关闭。请求 GitHub 公开发布元数据，不上传工作区、命令、日志或凭据。设置只属于当前工作区。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="更新渠道" FontWeight="SemiBold" Margin="0,14,0,5" />
                                    <ComboBox x:Name="UpdateChannelComboBox" SelectionChanged="UpdateChannelComboBox_SelectionChanged" IsEnabled="False">
                                        <ComboBoxItem Content="跟随当前版本" Tag="FollowCurrent" />
                                        <ComboBoxItem Content="仅稳定版" Tag="StableOnly" />
                                        <ComboBoxItem Content="包含预览版" Tag="IncludePreview" />
                                    </ComboBox>
                                    <Button x:Name="ManualUpdateCheckButton" Content="检查更新" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ManualUpdateCheck_Click" IsEnabled="False" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource LogBrush}" BorderBrush="#B9D6E6" BorderThickness="1" CornerRadius="14" Padding="18,15">
                                <StackPanel>
                                    <TextBlock Text="CHECK STATUS  /  检查状态" Foreground="#935B42" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="UpdateStatusText" Text="尚未检查" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="UpdateCandidateText" Foreground="{StaticResource JadeBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="OpenReleasePageButton" Content="查看发布页面" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenReleasePage_Click" IsEnabled="False" />
                                    <TextBlock x:Name="UpdateWarningText" Foreground="#9B4E42" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#FBFEFF" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="上次尝试" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,18,6" />
                                <TextBlock x:Name="LastUpdateAttemptText" Grid.Column="1" Text="无" FontFamily="{StaticResource CodeFont}" FontSize="10" />
                                <TextBlock Grid.Row="1" Text="上次成功" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,18,6" />
                                <TextBlock x:Name="LastUpdateSuccessText" Grid.Row="1" Grid.Column="1" Text="无" FontFamily="{StaticResource CodeFont}" FontSize="10" />
                                <TextBlock Grid.Row="2" Text="历史结果" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,18,0" />
                                <TextBlock x:Name="HistoricalUpdateResultText" Grid.Row="2" Grid.Column="1" Text="无完整成功记录" FontSize="10" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Background="#F0F8FC" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="本机记录" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="更新偏好" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,10,0,2" />
                                <TextBlock x:Name="UpdateSettingsPathText" FontFamily="{StaticResource CodeFont}" FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Text="更新缓存" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,2" />
                                <TextBlock x:Name="UpdateCachePathText" FontFamily="{StaticResource CodeFont}" FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Text="关闭应用后可删除缓存以重新获取元数据；删除偏好会恢复默认关闭，并清除跳过和稍后记录。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
