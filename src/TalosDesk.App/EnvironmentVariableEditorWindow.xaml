<Window x:Class="TalosDesk.App.EnvironmentVariableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TalosDesk · 环境变量" Width="560" Height="485" MinWidth="500" MinHeight="445"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BodyFont}" Icon="Assets/TalosDeskMark.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="添加环境变量" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="Bold" Margin="0,0,0,15" />
                <TextBlock Text="变量名" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource EditorTextBox}" AutomationProperties.AutomationId="EnvironmentName" TextChanged="NameBox_TextChanged" />
                <CheckBox x:Name="SensitiveBox" Content="敏感变量（使用当前 Windows 用户加密保存）" Margin="0,16,0,10"
                          AutomationProperties.AutomationId="EnvironmentSensitive" Checked="SensitiveBox_Changed" Unchecked="SensitiveBox_Changed" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,9" />
                <StackPanel x:Name="PlainPanel">
                    <TextBlock Text="普通值（明文）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PlainValueBox" Style="{StaticResource EditorTextBox}" AutomationProperties.AutomationId="EnvironmentPlainValue" />
                    <CheckBox x:Name="ConfirmPlainBox" Content="确认以明文保存新值（空字符串也算新值）" Margin="0,10,0,0"
                              AutomationProperties.AutomationId="EnvironmentConfirmPlain" Visibility="Collapsed" />
                    <TextBlock Text="普通值会出现在本机工作区和导出文件中。" Foreground="{StaticResource GoldBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="SecretPanel" Visibility="Collapsed">
                    <TextBlock Text="处理方式" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ActionBox" Style="{StaticResource EditorComboBox}" SelectionChanged="ActionBox_SelectionChanged"
                              AutomationProperties.AutomationId="EnvironmentAction" />
                    <StackPanel x:Name="SecretValuePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="新敏感值（可留空，表示显式空值）" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="SecretValueBox" Padding="9,7" MinHeight="35" BorderBrush="#B9D8E4" BorderThickness="1"
                                     Background="White" Foreground="{StaticResource InkBrush}" AutomationProperties.AutomationId="EnvironmentSecretValue" />
                    </StackPanel>
                    <TextBlock x:Name="RenameHintText" Foreground="{StaticResource GoldBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                    <TextBlock Text="已保存的敏感值不会回填到输入框；导出时会变成待填写。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource EditorButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存变量" Style="{StaticResource EditorPrimaryButton}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
