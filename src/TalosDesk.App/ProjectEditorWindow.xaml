<Window x:Class="TalosDesk.App.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TalosDesk · 项目" Width="620" Height="430" MinWidth="540" MinHeight="390"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BodyFont}" Icon="Assets/TalosDeskMark.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource EditorHeaderBrush}" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Margin="0,0,0,18" Padding="18,13" ClipToBounds="True">
            <Grid>
                <Image Source="Assets/TalosDeskMark.png" Width="104" Height="104" Opacity="0.13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" />
                <StackPanel>
                    <TextBlock Text="TALOS  /  PROJECT" Foreground="{StaticResource JadeBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="HeadingText" Text="添加项目" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="选择本地文件夹并命名；工具程序目录也可以，不要求完整源码项目。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="项目名称" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Style="{StaticResource EditorTextBox}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="项目文件夹" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="DirectoryBox" Style="{StaticResource EditorTextBox}" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource EditorButton}" Margin="8,0,0,0" Click="BrowseDirectory_Click" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="更改项目文件夹后，项目内的命令会保留原有的相对运行目录。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource EditorButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="添加项目" Style="{StaticResource EditorPrimaryButton}" IsDefault="True" Click="SaveProject_Click" />
        </StackPanel>
    </Grid>
</Window>
