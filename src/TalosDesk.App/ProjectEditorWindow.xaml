<Window x:Class="TalosDesk.App.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目" Width="620" Height="360" MinWidth="540" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#E8EDF2" Foreground="#182C39" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#C9D3DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#182C39" />
            <Setter Property="BorderBrush" Value="#C9D3DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" Text="添加项目" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="选择本地文件夹并为项目命名。" Foreground="#647583" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="项目名称" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="NameBox" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="项目文件夹" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="DirectoryBox" />
                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseDirectory_Click" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="更改项目文件夹后，项目内的命令会保留原有的相对运行目录。" Foreground="#647583" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="添加项目" Background="#B45A3C" BorderBrush="#B45A3C" Foreground="White" FontWeight="SemiBold" IsDefault="True" Click="SaveProject_Click" />
        </StackPanel>
    </Grid>
</Window>
