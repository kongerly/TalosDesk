<Window x:Class="TalosDesk.App.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="clr-namespace:TalosDesk.App.Editing"
        Title="TalosDesk · 命令" Width="650" Height="670" MinWidth="560" MinHeight="625"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource BodyFont}" Icon="Assets/TalosDeskMark.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource EditorHeaderBrush}" BorderBrush="#B9D8E4" BorderThickness="1" CornerRadius="13" Margin="0,0,0,17" Padding="18,13" ClipToBounds="True">
            <Grid>
                <Image Source="Assets/TalosDeskMark.png" Width="104" Height="104" Opacity="0.13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" />
                <StackPanel>
                    <TextBlock Text="TALOS  /  COMMAND" Foreground="{StaticResource JadeBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="HeadingText" Text="添加命令" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="设置命令内容及其运行目录。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource EditorTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="运行类型" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="KindBox" Style="{StaticResource EditorComboBox}" SelectedIndex="0">
                    <ComboBoxItem Content="任务" Tag="Task" />
                    <ComboBoxItem Content="服务" Tag="Service" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="用途说明" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PurposeBox" Style="{StaticResource EditorTextBox}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="运行目录" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="WorkingDirectoryBox" Style="{StaticResource EditorTextBox}" TextChanged="WorkingDirectoryBox_TextChanged" />
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource EditorButton}" Margin="8,0,0,0" Click="BrowseDirectory_Click" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <TextBlock Text="命令" Style="{StaticResource FieldLabel}" />
            <editing:PowerShellCommandEditor x:Name="CommandBox" AutomationProperties.AutomationId="CommandEditorHost" MinHeight="145" SaveRequested="CommandBox_SaveRequested" />
            <TextBlock Text="命令会以明文保存在本机配置和导出文件中。请使用环境变量或外部凭据工具，不要直接填写密钥。命令通过 PowerShell 7 非交互运行，不加载个人配置文件；目录中的程序可用 .\程序名.exe。" Foreground="{StaticResource GoldBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource EditorButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="保存命令" Style="{StaticResource EditorPrimaryButton}" IsDefault="True" Click="SaveCommand_Click" />
        </StackPanel>
    </Grid>
</Window>
