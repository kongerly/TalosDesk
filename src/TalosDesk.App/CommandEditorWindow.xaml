<Window x:Class="TalosDesk.App.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command" Width="620" Height="570" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#E8EDF2" Foreground="#182C39" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#C9D3DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#182C39" />
            <Setter Property="BorderBrush" Value="#C9D3DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" Text="Add command" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Save the exact command and the folder it should run from." Foreground="#647583" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Run type" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox x:Name="KindBox" Padding="8,7" SelectedIndex="0">
                    <ComboBoxItem Content="Task" Tag="Task" />
                    <ComboBoxItem Content="Service" Tag="Service" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Purpose" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="PurposeBox" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Working folder" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="WorkingDirectoryBox" />
                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="BrowseDirectory_Click" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,18">
            <TextBlock Text="Command" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="CommandBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="12" MinHeight="100" />
            <TextBlock Text="Runs in PowerShell 7 without loading your profile. TalosDesk does not support interactive input." Foreground="#647583" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save command" Background="#B45A3C" BorderBrush="#B45A3C" Foreground="White" FontWeight="SemiBold" IsDefault="True" Click="SaveCommand_Click" />
        </StackPanel>
    </Grid>
</Window>
